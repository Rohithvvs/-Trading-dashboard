# Server-only Vercel environment variables. Never prefix secrets with VITE_.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_with_read_only_turso_token
# Optional, only this value accepted. Not a client-selected namespace.
PAPER_NAMESPACE=paper_v1
# Local-only alternative: absolute external env path; do NOT set on Vercel.
# LOCAL_TURSO_ENV_FILE=/absolute/path/to/existing.env
